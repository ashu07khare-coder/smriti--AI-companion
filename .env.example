# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Your Supabase Project URL (e.g. https://your-project.supabase.co)
SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY or SUPABASE_ANON_KEY: Used by the server to query Supabase tables
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# BHASHINI_USER_ID, BHASHINI_API_KEY, BHASHINI_INFERENCE_API_KEY:
# Credentials for National Language Translation Mission (Bhashini / Dhruva) API
# for Indic voice-to-text (ASR), translation (NMT), and text-to-speech (TTS).
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_INFERENCE_API_KEY=
